# SITE_ADDRESS is a public hostname (Caddy obtains a Let's Encrypt certificate)
# or "localhost" for a local check (Caddy uses its own internal CA).
{$SITE_ADDRESS} {
	encode zstd gzip

	# Task prompts are capped at 10,000 characters; refuse anything far larger.
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8000
}
