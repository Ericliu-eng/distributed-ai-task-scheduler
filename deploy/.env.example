# Copy to deploy/.env (ignored by git). On EC2 the instance writes this file at boot.
# Generate a password with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# A public hostname for HTTPS, for example 203-0-113-10.sslip.io, or localhost to test locally.
SITE_ADDRESS=localhost
# Optional overrides.
# HTTP_PORT=80
# HTTPS_PORT=443
# RATE_LIMIT_PER_MINUTE=20
# MAX_ACTIVE_TASKS=200
# RETENTION_MINUTES=60
