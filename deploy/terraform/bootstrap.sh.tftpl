#!/bin/bash
# First boot on Amazon Linux 2023 (arm64): install Docker, fetch Orbit, start the stack.
# Logs: /var/log/cloud-init-output.log
set -euo pipefail

# A 2 GB instance builds the image more reliably with swap.
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
fi

dnf install -y docker git
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-aarch64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

if [ ! -d /opt/orbit ]; then
  git clone --depth 1 --branch "${git_ref}" "${repo_url}" /opt/orbit
fi
cd /opt/orbit/deploy

# The database password is generated here and never leaves the instance.
if [ ! -f .env ]; then
  umask 077
  printf 'POSTGRES_PASSWORD=%s\nSITE_ADDRESS=%s\n' "$(openssl rand -hex 24)" "${site_address}" > .env
fi

docker compose -f compose.prod.yml up -d --build
