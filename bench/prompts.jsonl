{"id":"code-003","category":"code","difficulty":"easy","prompt":"Write solve(a,b) that returns the larger value.","prompt_length":100,"grader":"code_assert","answer":"maximum","assertions":["solve(2,5) == 5","solve(9,1) == 9","solve(3,3) == 3"],"small_response":"def solve(a, b):\n    return a if a >= b else b","large_response":"def solve(a, b):\n    return a if a >= b else b"}
