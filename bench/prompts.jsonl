{"id":"code-006","category":"code","difficulty":"hard","prompt":"Implement solve(values) to return the second-largest distinct integer under all specified edge cases.","prompt_length":800,"grader":"code_assert","answer":"second-largest","assertions":["solve([1,5,3]) == 3","solve([4,4,2]) == 2","solve([-1,-5,-3]) == -3"],"small_response":"def solve(values):\n    return sorted(values)[-2]","large_response":"def solve(values):\n    return sorted(set(values))[-2]"}
{"id":"code-007","category":"code","difficulty":"hard","prompt":"Implement solve(values) to return the length of the longest strictly increasing contiguous run.","prompt_length":800,"grader":"code_assert","answer":"increasing-run","assertions":["solve([1,2,3,1]) == 3","solve([3,2,1]) == 1","solve([1,2,2,3]) == 2"],"small_response":"def solve(values):\n    return len(values)","large_response":"def solve(values):\n    best = current = 1\n    for i in range(1, len(values)):\n        current = current + 1 if values[i] > values[i-1] else 1\n        best = best if best >= current else current\n    return best"}
{"id":"code-008","category":"code","difficulty":"hard","prompt":"Implement solve(text) to validate balanced parentheses while ignoring non-parenthesis characters.","prompt_length":800,"grader":"code_assert","answer":"balanced-parentheses","assertions":["solve('(a(b)c)') is True","solve(')(') is False","solve('(()') is False"],"small_response":"def solve(text):\n    return text.count('(') == text.count(')')","large_response":"def solve(text):\n    depth = 0\n    for char in text:\n        if char == '(': depth += 1\n        elif char == ')':\n            depth -= 1\n            if depth < 0: return False\n    return depth == 0"}
{"id":"code-009","category":"code","difficulty":"hard","prompt":"Implement solve(values) to remove duplicates while preserving the first-seen order.","prompt_length":800,"grader":"code_assert","answer":"stable-deduplicate","assertions":["solve([3,1,3,2]) == [3,1,2]","solve([]) == []","solve([1,1]) == [1]"],"small_response":"def solve(values):\n    return list(set(values))","large_response":"def solve(values):\n    result = []\n    for value in values:\n        if value not in result: result.append(value)\n    return result"}
{"id":"code-010","category":"code","difficulty":"hard","prompt":"Implement solve(n) to return the nth Fibonacci number with solve(0) equal to zero.","prompt_length":80,"grader":"code_assert","answer":"fibonacci","assertions":["solve(0) == 0","solve(1) == 1","solve(7) == 13"],"small_response":"def solve(n):\n    return n","large_response":"def solve(n):\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a"}
